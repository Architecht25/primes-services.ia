<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administration - Primes Services</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gray-50">
  <!-- Sidebar -->
  <div class="fixed top-0 left-0 h-screen w-64 bg-gradient-to-b from-primary-900 to-primary-700 text-white overflow-y-auto flex flex-col">
    <div class="px-6 pt-8 pb-6">
      <%= link_to root_path, class: "flex items-center space-x-3" do %>
        <img src="/logo.jpg" class="h-10 w-auto brightness-0 invert" alt="Primes Services">
      <% end %>
      <p class="text-xs text-primary-200 mt-3 tracking-wide uppercase">Administration</p>
    </div>

    <nav class="flex-1">
      <%= link_to admin_dashboard_path,
          class: "block px-6 py-3 text-primary-100 hover:text-white hover:bg-white/10 transition-colors #{'bg-white/10 text-white border-l-4 border-amber-400' if current_page?(admin_dashboard_path)}" do %>
        📊 Dashboard
      <% end %>

      <%= link_to admin_contacts_path,
          class: "block px-6 py-3 text-primary-100 hover:text-white hover:bg-white/10 transition-colors #{'bg-white/10 text-white border-l-4 border-amber-400' if current_page?(admin_contacts_path)}" do %>
        📧 Contacts
      <% end %>

      <%= link_to admin_security_path,
          class: "block px-6 py-3 text-primary-100 hover:text-white hover:bg-white/10 transition-colors #{'bg-white/10 text-white border-l-4 border-amber-400' if current_page?(admin_security_path)}" do %>
        🔒 Sécurité
      <% end %>

      <hr class="my-4 border-white/20 mx-6">

      <%= link_to root_path, class: "block px-6 py-3 text-primary-100 hover:text-white hover:bg-white/10 transition-colors" do %>
        🏠 Retour au site
      <% end %>

      <%= button_to admin_logout_path, method: :delete,
          class: "block w-full text-left px-6 py-3 text-primary-100 hover:text-white hover:bg-white/10 transition-colors bg-transparent border-0 cursor-pointer" do %>
        🚪 Déconnexion
      <% end %>
    </nav>

    <div class="px-6 py-4 text-xs text-primary-300">
      <%= Rails.env %> · Ruby <%= RUBY_VERSION %>
    </div>
  </div>

  <!-- Main Content -->
  <div class="ml-64 p-8 min-h-screen">
    <% if flash[:notice] %>
      <div class="bg-secondary-600 text-white px-4 py-3 rounded-lg mb-4 shadow">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="bg-red-600 text-white px-4 py-3 rounded-lg mb-4 shadow">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= yield %>
  </div>
</body>
</html>
