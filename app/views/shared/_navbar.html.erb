<!-- Navigation responsive pour primes-services.ia -->
<nav class="bg-white shadow-lg fixed w-full top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <!-- Logo et nom -->
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center space-x-3", aria: { label: "Primes Services - Accueil" } do %>
          <img src="/logo.jpg" class="h-10 w-auto" alt="Primes Services">
        <% end %>
      </div>

      <!-- Navigation desktop -->
      <div class="hidden md:flex items-center space-x-8">
        <%= link_to root_path,
            class: "text-gray-700 hover:text-primary-600 font-medium transition-colors #{'text-primary-600' if current_page?(root_path)}" do %>
          🏠 Accueil
        <% end %>

        <%= link_to simulation_path,
            class: "text-gray-700 hover:text-primary-600 font-medium transition-colors #{'text-primary-600' if current_page?(simulation_path)}" do %>
          🧮 Simulation
        <% end %>

        <%= link_to renovate_path,
            class: "text-gray-700 hover:text-secondary-600 font-medium transition-colors #{'text-secondary-600' if current_page?(renovate_path)}" do %>
          🚀 Ren0vate
        <% end %>

        <%= link_to about_path,
            class: "text-gray-700 hover:text-primary-600 font-medium transition-colors #{'text-primary-600' if current_page?(about_path)}" do %>
          👥 À propos
        <% end %>

        <!-- CTA Principal -->
        <%= link_to new_contact_path,
            class: "bg-primary-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-primary-700 transition-colors" do %>
          📋 Demander une analyse
        <% end %>
      </div>

      <!-- Menu mobile toggle -->
      <div class="md:hidden">
        <button
          data-controller="mobile-menu"
          data-action="click->mobile-menu#toggle"
          class="text-gray-700 hover:text-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500 rounded"
          aria-label="Ouvrir le menu de navigation"
          aria-expanded="false"
          data-mobile-menu-target="toggle"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Menu mobile -->
    <div
      data-mobile-menu-target="menu"
      class="md:hidden border-t border-gray-200 bg-white hidden"
    >
      <div class="px-2 pt-2 pb-3 space-y-1">
        <%= link_to root_path,
            class: "block px-3 py-2 text-gray-700 hover:text-primary-600 hover:bg-primary-50 rounded-md font-medium" do %>
          🏠 Accueil
        <% end %>

        <%= link_to simulation_path,
            class: "block px-3 py-2 text-gray-700 hover:text-primary-600 hover:bg-primary-50 rounded-md font-medium" do %>
          🧮 Simulation
        <% end %>

        <%= link_to renovate_path,
            class: "block px-3 py-2 text-gray-700 hover:text-secondary-600 hover:bg-secondary-50 rounded-md font-medium" do %>
          🚀 Ren0vate
        <% end %>

        <%= link_to about_path,
            class: "block px-3 py-2 text-gray-700 hover:text-primary-600 hover:bg-primary-50 rounded-md font-medium" do %>
          👥 À propos
        <% end %>

        <!-- CTA Mobile -->
        <%= link_to new_contact_path,
            class: "block mx-3 mt-4 bg-primary-600 text-white px-4 py-2 rounded-lg font-semibold text-center hover:bg-primary-700 transition-colors" do %>
          📋 Demander une analyse
        <% end %>
      </div>
    </div>
  </div>
</nav>

<!-- Espace pour compenser la navigation fixe -->
<div class="h-16"></div>
