<% if ENV["TURNSTILE_SITE_KEY"].present? %>
  <% content_for :head do %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% end %>
<% end %>

<div class="max-w-2xl mx-auto px-4 py-12">
  <div class="text-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Demander une analyse de situation</h1>
    <p class="text-lg text-gray-600">
      Décrivez votre projet, nous analysons votre situation et vous recontactons rapidement
      pour convenir d'un rendez-vous.
    </p>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <%= form_with model: @contact, url: contacts_path, local: true,
        data: { controller: "form-validation", action: "submit->form-validation#handleSubmit" } do |form| %>

      <% if @contact.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
          <h3 class="text-red-800 font-semibold mb-2">Erreurs dans le formulaire :</h3>
          <ul class="text-red-700 list-disc list-inside">
            <% @contact.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <div>
          <%= form.label :name, "Nom complet *", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :name,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500",
              required: true,
              data: { validate: "required minlength", minlength: 2, error_required: "Votre nom est obligatoire." } %>
        </div>

        <div>
          <%= form.label :email, "Email *", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.email_field :email,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500",
              required: true,
              data: { validate: "required email", error_required: "Votre email est obligatoire." } %>
        </div>

        <div>
          <%= form.label :phone, "Téléphone", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :phone,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500",
              type: "tel",
              data: { validate: "phone" } %>
        </div>

        <div>
          <%= form.label :region, "Région *", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.select :region,
              options_for_select([
                ['Wallonie', 'wallonie'],
                ['Flandre', 'flandre'],
                ['Bruxelles-Capitale', 'bruxelles']
              ], @contact.region),
              { prompt: 'Sélectionnez votre région' },
              { class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500",
                required: true,
                data: { validate: "required", error_required: "Veuillez sélectionner votre région." } } %>
        </div>
      </div>

      <div class="mb-6">
        <%= form.label :message, "Votre situation / vos questions", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :message, rows: 5,
            placeholder: "Décrivez votre projet, le type de logement, les travaux envisagés, vos questions...",
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500",
            data: { validate: "maxlength", maxlength: 2000 } %>
      </div>

      <div class="bg-primary-50 border border-primary-200 rounded-lg p-4 mb-6">
        <div class="flex items-start">
          <svg class="w-5 h-5 text-primary-600 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <div>
            <h4 class="text-primary-900 font-semibold mb-1">Et ensuite ?</h4>
            <p class="text-primary-800 text-sm">
              Vous recevrez une confirmation par email. Robin analyse personnellement votre demande
              et vous recontacte rapidement pour fixer un rendez-vous.
            </p>
          </div>
        </div>
      </div>

      <% if ENV["TURNSTILE_SITE_KEY"].present? %>
        <div class="mb-6 flex justify-center">
          <div class="cf-turnstile" data-sitekey="<%= ENV['TURNSTILE_SITE_KEY'] %>"></div>
        </div>
      <% end %>

      <div class="text-center">
        <%= form.submit "Demander une analyse de situation",
            class: "bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors duration-200 inline-flex items-center",
            data: { "form-validation-target": "submit" } %>
      </div>

      <%# Honeypot anti-spam: hidden field, must remain empty %>
      <div aria-hidden="true" style="position:absolute;left:-9999px;visibility:hidden;">
        <%= label_tag :website, "Website (leave blank)" %>
        <%= text_field_tag :website, nil, autocomplete: "off", tabindex: -1 %>
      </div>
    <% end %>
  </div>
</div>
