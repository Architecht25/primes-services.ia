<div>
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">📜 Logs de sécurité</h1>
    <%= link_to "← Retour", admin_security_path, class: "px-6 py-3 border border-gray-300 rounded-lg text-gray-500 hover:bg-gray-50 transition-colors font-semibold" %>
  </div>

  <!-- Filtre par sévérité -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
    <div class="flex gap-3 flex-wrap">
      <%= link_to "Tous", admin_security_logs_path,
          class: "px-4 py-2 rounded-full text-sm font-semibold #{params[:severity].blank? ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% %w[info warning critical].each do |severity| %>
        <%= link_to severity.capitalize, admin_security_logs_path(severity: severity),
            class: "px-4 py-2 rounded-full text-sm font-semibold #{params[:severity] == severity ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% end %>
    </div>
  </div>

  <!-- Table des logs -->
  <div class="bg-white rounded-lg shadow-lg overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b-2 border-gray-200">
          <th class="p-4 text-left text-gray-500 text-sm">Date</th>
          <th class="p-4 text-left text-gray-500 text-sm">Événement</th>
          <th class="p-4 text-left text-gray-500 text-sm">Sévérité</th>
          <th class="p-4 text-left text-gray-500 text-sm">IP</th>
          <th class="p-4 text-left text-gray-500 text-sm">Description</th>
        </tr>
      </thead>
      <tbody>
        <% if @security_logs.any? %>
          <% @security_logs.each do |log| %>
            <tr class="border-b border-gray-200">
              <td class="p-4 whitespace-nowrap"><%= log.created_at.strftime('%d/%m/%Y %H:%M') %></td>
              <td class="p-4 font-mono text-xs"><%= log.event_type %></td>
              <td class="p-4">
                <% badge = case log.severity
                     when 'critical' then 'bg-red-600'
                     when 'warning' then 'bg-amber-500'
                     else 'bg-primary-600'
                   end %>
                <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= badge %>"><%= log.severity %></span>
              </td>
              <td class="p-4 text-gray-500 font-mono text-xs"><%= log.ip_address || '-' %></td>
              <td class="p-4 text-gray-500"><%= log.description %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="p-12 text-center text-gray-500">Aucun log trouvé</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
