<div>
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">🔍 Scan de sécurité</h1>
    <%= link_to "← Retour", admin_security_path, class: "px-6 py-3 border border-gray-300 rounded-lg text-gray-500 hover:bg-gray-50 transition-colors font-semibold" %>
  </div>

  <!-- Statut global -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
    <div class="flex items-center gap-4">
      <div class="text-5xl"><%= @scan_results[:overall_status] == 'secure' ? '✅' : '⚠️' %></div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900">
          <%= @scan_results[:overall_status] == 'secure' ? 'Sécurisé' : 'Attention requise' %>
        </h2>
        <p class="text-gray-500 mt-1">Scan effectué le <%= @scan_results[:timestamp].strftime('%d/%m/%Y à %H:%M') %></p>
      </div>
    </div>
  </div>

  <!-- Checks -->
  <div class="flex flex-col gap-4">
    <% @scan_results[:checks].each do |check| %>
      <div class="bg-white rounded-lg shadow-lg p-6">
        <div class="flex justify-between items-center mb-3">
          <h3 class="font-semibold text-gray-900"><%= check[:name] %></h3>
          <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= check[:status] == 'pass' ? 'bg-secondary-600' : 'bg-amber-500' %>"><%= check[:status] %></span>
        </div>
        <div class="text-gray-500 text-sm">
          <% if check[:details].is_a?(Hash) %>
            <% check[:details].each do |key, value| %>
              <div><strong class="text-gray-700"><%= key.to_s.humanize %> :</strong> <%= value.is_a?(Array) ? value.join(', ').presence || 'aucun' : value %></div>
            <% end %>
          <% else %>
            <%= check[:details] %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
