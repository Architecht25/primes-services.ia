<div>
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">💓 Health Check</h1>
    <%= link_to "← Retour", admin_security_path, class: "px-6 py-3 border border-gray-300 rounded-lg text-gray-500 hover:bg-gray-50 transition-colors font-semibold" %>
  </div>

  <div class="grid gap-6 mb-8" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
    <!-- Database -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="font-semibold text-gray-900 mb-4">🗄️ Base de données</h3>
      <div class="flex justify-between items-center">
        <span>Statut</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= @health_status.dig(:database, :status) == 'ok' ? 'bg-secondary-600' : 'bg-red-600' %>">
          <%= @health_status.dig(:database, :status) %>
        </span>
      </div>
      <% if @health_status.dig(:database, :latency) %>
        <div class="mt-2 text-gray-500 text-sm">Latence : <%= @health_status.dig(:database, :latency) %>ms</div>
      <% end %>
      <% if @health_status.dig(:database, :message) %>
        <div class="mt-2 text-red-600 text-sm"><%= @health_status.dig(:database, :message) %></div>
      <% end %>
    </div>

    <!-- Cache (Redis / Solid Cache) -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="font-semibold text-gray-900 mb-4">⚡ Cache</h3>
      <div class="flex justify-between items-center">
        <span>Statut</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= @health_status.dig(:redis, :status) == 'ok' ? 'bg-secondary-600' : 'bg-red-600' %>">
          <%= @health_status.dig(:redis, :status) %>
        </span>
      </div>
      <% if @health_status.dig(:redis, :message) %>
        <div class="mt-2 text-red-600 text-sm"><%= @health_status.dig(:redis, :message) %></div>
      <% end %>
    </div>

    <!-- Stockage -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="font-semibold text-gray-900 mb-4">💾 Stockage</h3>
      <div class="flex justify-between items-center">
        <span>Utilisation</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-primary-600"><%= @health_status.dig(:storage, :usage) || '?' %></span>
      </div>
      <div class="mt-2 text-gray-500 text-sm">
        <%= @health_status.dig(:storage, :used) %> / <%= @health_status.dig(:storage, :total) %>
        (<%= @health_status.dig(:storage, :available) %> disponible)
      </div>
    </div>

    <!-- SSL -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="font-semibold text-gray-900 mb-4">🔐 SSL</h3>
      <div class="flex justify-between items-center">
        <span>Connexion actuelle</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= @health_status.dig(:ssl, :status) == 'ok' ? 'bg-secondary-600' : 'bg-amber-500' %>">
          <%= @health_status.dig(:ssl, :ssl_enabled) ? 'HTTPS' : 'HTTP' %>
        </span>
      </div>
      <div class="mt-2 text-gray-500 text-sm">Protocole : <%= @health_status.dig(:ssl, :protocol) %></div>
    </div>
  </div>

  <!-- Headers de sécurité -->
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-5">🛡️ Headers de sécurité (requête actuelle)</h2>
    <div class="flex flex-col gap-2">
      <% (@health_status[:headers] || []).each do |h| %>
        <div class="flex justify-between py-2 border-b border-gray-200">
          <span class="font-mono text-sm"><%= h[:header] %></span>
          <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= h[:present] ? 'bg-secondary-600' : 'bg-amber-500' %>">
            <%= h[:present] ? (h[:value].presence || 'présent') : 'absent' %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</div>
