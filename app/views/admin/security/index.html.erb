<div>
  <h1 class="text-3xl font-bold text-gray-900 mb-8">🔒 Monitoring Sécurité</h1>

  <!-- Status global -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
    <div class="flex items-center gap-4">
      <div class="text-5xl">
        <%= @security_status[:health][:status] == 'healthy' ? '✅' : '⚠️' %>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900">
          Statut : <%= @security_status[:health][:status]&.titleize || 'Unknown' %>
        </h2>
        <p class="text-gray-500 mt-1">Dernière vérification : <%= Time.current.strftime('%d/%m/%Y à %H:%M') %></p>
      </div>
    </div>
  </div>

  <!-- Checks de sécurité -->
  <div class="grid gap-6 mb-8" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
    <!-- Database Health -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="font-semibold text-gray-900 mb-4">🗄️ Base de données</h3>
      <% db_status = @security_status.dig(:health, :database, :status) %>
      <div class="flex justify-between items-center">
        <span>Statut</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= db_status == 'ok' ? 'bg-secondary-600' : 'bg-red-600' %>"><%= db_status %></span>
      </div>
      <% if @security_status.dig(:health, :database, :latency_ms) %>
        <div class="mt-2 text-gray-500 text-sm">Latence : <%= @security_status.dig(:health, :database, :latency_ms) %>ms</div>
      <% end %>
    </div>

    <!-- SSL Status -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="font-semibold text-gray-900 mb-4">🔐 SSL/HTTPS</h3>
      <% ssl_valid = @security_status.dig(:ssl_status, :valid) %>
      <div class="flex justify-between items-center">
        <span>Statut</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= ssl_valid ? 'bg-secondary-600' : 'bg-amber-500' %>"><%= ssl_valid ? 'Actif' : 'Inactif' %></span>
      </div>
      <% if @security_status.dig(:ssl_status, :force_ssl) %>
        <div class="mt-2 text-gray-500 text-sm">Force SSL : <%= @security_status.dig(:ssl_status, :force_ssl) %></div>
      <% end %>
    </div>

    <!-- Disk Usage -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="font-semibold text-gray-900 mb-4">💾 Espace disque</h3>
      <% disk_status = @security_status.dig(:health, :disk_usage, :status) %>
      <div class="flex justify-between items-center">
        <span>Utilisation</span>
        <% badge = disk_status == 'ok' ? 'bg-secondary-600' : (disk_status == 'warning' ? 'bg-amber-500' : 'bg-red-600') %>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= badge %>"><%= @security_status.dig(:health, :disk_usage, :usage_percent) || 0 %>%</span>
      </div>
    </div>
  </div>

  <!-- Recommandations de sécurité -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-5">📋 Recommandations de sécurité</h2>
    <% if @security_status[:recommendations]&.any? %>
      <div class="flex flex-col gap-4">
        <% @security_status[:recommendations].each do |rec| %>
          <% border = rec[:priority] == 'critical' ? 'border-red-500' : (rec[:priority] == 'high' ? 'border-amber-500' : 'border-primary-500') %>
          <% badge = rec[:priority] == 'critical' ? 'bg-red-600' : (rec[:priority] == 'high' ? 'bg-amber-500' : 'bg-primary-600') %>
          <div class="p-4 bg-amber-50 border-l-4 <%= border %> rounded">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-semibold text-gray-900"><%= rec[:title] %></h3>
              <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= badge %>"><%= rec[:priority]&.upcase %></span>
            </div>
            <p class="text-gray-500 text-sm"><%= rec[:description] %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-secondary-600 text-center py-8">✅ Aucune recommandation - Tout est en ordre !</p>
    <% end %>
  </div>

  <!-- Activité suspecte -->
  <% if @security_status[:suspicious_activity]&.any? %>
    <div class="bg-white rounded-lg shadow-lg p-6 mb-8 border-2 border-red-500">
      <h2 class="text-xl font-bold text-red-600 mb-5">⚠️ Activités suspectes détectées</h2>
      <div class="flex flex-col gap-4">
        <% @security_status[:suspicious_activity].each do |activity| %>
          <div class="p-4 bg-red-50 rounded-lg">
            <div class="flex justify-between">
              <span class="font-semibold"><%= activity[:type] %></span>
              <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-red-600"><%= activity[:severity] %></span>
            </div>
            <p class="mt-2 text-gray-500 text-sm">IP : <%= activity[:ip] %> | Tentatives : <%= activity[:count] %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Actions -->
  <div class="flex gap-4 flex-wrap">
    <%= link_to admin_security_scan_path, class: "bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors" do %>
      🔍 Lancer un scan complet
    <% end %>
    <%= link_to admin_security_health_path, class: "bg-secondary-600 hover:bg-secondary-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors" do %>
      💓 Health Check
    <% end %>
    <%= link_to admin_security_logs_path, class: "bg-amber-500 hover:bg-amber-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors" do %>
      📜 Logs de sécurité
    <% end %>
  </div>
</div>
