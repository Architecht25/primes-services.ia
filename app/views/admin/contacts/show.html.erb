<div>
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">📧 Détail du Contact</h1>
      <p class="text-gray-500 mt-2">Soumis le <%= @contact.created_at.strftime('%d/%m/%Y à %H:%M') %></p>
    </div>
    <%= link_to "← Retour à la liste", admin_contacts_path, class: "px-6 py-3 border border-gray-300 rounded-lg text-gray-500 hover:bg-gray-50 transition-colors font-semibold" %>
  </div>

  <!-- Info principale -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
    <div class="grid gap-6" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
      <div>
        <p class="text-gray-500 text-sm">Nom complet</p>
        <p class="text-lg font-semibold text-gray-900 mt-1"><%= @contact.name %></p>
      </div>
      <div>
        <p class="text-gray-500 text-sm">Email</p>
        <p class="text-lg font-semibold text-gray-900 mt-1"><%= mail_to @contact.email %></p>
      </div>
      <div>
        <p class="text-gray-500 text-sm">Téléphone</p>
        <p class="text-lg font-semibold text-gray-900 mt-1"><%= @contact.phone || '-' %></p>
      </div>
      <div>
        <p class="text-gray-500 text-sm">Région</p>
        <p class="text-lg font-semibold text-gray-900 mt-1"><%= @contact.region&.titleize || '-' %></p>
      </div>
    </div>
  </div>

  <!-- Statuts -->
  <div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
    <div class="bg-white rounded-lg shadow-lg p-6">
      <p class="text-gray-500 text-sm">Type de soumission</p>
      <p class="mt-2">
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-primary-600"><%= @contact.type %></span>
      </p>
    </div>
    <div class="bg-white rounded-lg shadow-lg p-6">
      <p class="text-gray-500 text-sm">Statut</p>
      <p class="mt-2">
        <% badge_class, label = case @contact.status
             when 'pending' then ['bg-amber-500', 'En attente']
             when 'processed' then ['bg-primary-600', 'Traité']
             when 'completed' then ['bg-secondary-600', 'Terminé']
             else ['bg-gray-400', 'Non défini']
           end %>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= badge_class %>"><%= label %></span>
      </p>
    </div>
    <div class="bg-white rounded-lg shadow-lg p-6">
      <p class="text-gray-500 text-sm">Lu/Non lu</p>
      <p class="mt-2">
        <% if @contact.read? %>
          <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-secondary-600">Lu le <%= @contact.read_at.strftime('%d/%m/%Y') %></span>
        <% else %>
          <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-amber-500">Non lu</span>
        <% end %>
      </p>
    </div>
  </div>

  <!-- Message -->
  <% if @contact.message.present? %>
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">💬 Message</h2>
      <div class="bg-gray-50 p-6 rounded-lg border-l-4 border-primary-500">
        <%= simple_format(@contact.message) %>
      </div>
    </div>
  <% end %>

  <!-- Metadata technique -->
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">🔧 Informations techniques</h2>
    <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
      <div>
        <p class="text-gray-500 text-sm">ID de contact</p>
        <p class="font-mono font-semibold mt-1"><%= @contact.id %></p>
      </div>
      <div>
        <p class="text-gray-500 text-sm">Date de soumission</p>
        <p class="font-semibold mt-1">
          <%= @contact.submitted_at&.strftime('%d/%m/%Y à %H:%M') || @contact.created_at.strftime('%d/%m/%Y à %H:%M') %>
        </p>
      </div>
      <% if @contact.ip_address.present? %>
        <div>
          <p class="text-gray-500 text-sm">Adresse IP</p>
          <p class="font-mono font-semibold mt-1"><%= @contact.ip_address %></p>
        </div>
      <% end %>
      <% if @contact.processed_at.present? %>
        <div>
          <p class="text-gray-500 text-sm">Traité le</p>
          <p class="font-semibold mt-1"><%= @contact.processed_at.strftime('%d/%m/%Y à %H:%M') %></p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Actions -->
  <div class="mt-8 flex gap-4 flex-wrap items-center">
    <% unless @contact.read? %>
      <%= button_to "Marquer comme lu", mark_read_admin_contact_path(@contact), method: :post, class: "bg-secondary-600 hover:bg-secondary-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors" %>
    <% end %>

    <%= link_to admin_contacts_path, class: "bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors" do %>
      ← Retour à la liste
    <% end %>

    <%= button_to "🗑 Supprimer ce contact", admin_contact_path(@contact), method: :delete, data: { turbo_confirm: "Supprimer ce contact définitivement ? Cette action est irréversible." }, class: "bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors ml-auto" %>
  </div>
</div>
