<div>
  <div class="flex justify-between items-center mb-8 flex-wrap gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">📊 Tableau de Bord</h1>
      <p class="text-gray-500 mt-1"><%= Time.current.strftime('%A %d %B %Y, %H:%M') %></p>
    </div>
    <div class="flex gap-3">
      <%= link_to export_admin_contacts_path(format: :csv), class: "bg-secondary-600 hover:bg-secondary-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors" do %>
        📥 Export CSV
      <% end %>
    </div>
  </div>

  <!-- KPIs principaux -->
  <div class="grid gap-6 mb-8" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">

    <!-- Contacts formulaires -->
    <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-amber-500">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-gray-500 text-xs uppercase tracking-wide">Contacts formulaires</p>
          <p class="text-3xl font-bold text-gray-900 mt-2"><%= @stats.dig(:contacts, :total) || 0 %></p>
        </div>
        <div class="bg-amber-500 text-white p-3 rounded-lg text-xl">📧</div>
      </div>
      <div class="mt-4 pt-4 border-t border-gray-200 flex justify-between items-center">
        <span><span class="text-secondary-600 font-semibold">+<%= @stats.dig(:contacts, :today) || 0 %></span> <span class="text-gray-500 text-xs">aujourd'hui</span></span>
        <% unread = @stats.dig(:contacts, :unread) || 0 %>
        <% if unread > 0 %>
          <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-amber-500"><%= unread %> non lus</span>
        <% end %>
      </div>
    </div>

    <!-- Ren0vate -->
    <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-secondary-500">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-gray-500 text-xs uppercase tracking-wide">Clics Ren0vate</p>
          <p class="text-3xl font-bold text-gray-900 mt-2"><%= @stats.dig(:renovate, :total_clicks) || 0 %></p>
        </div>
        <div class="bg-secondary-600 text-white p-3 rounded-lg text-xl">🏠</div>
      </div>
      <div class="mt-4 pt-4 border-t border-gray-200 flex justify-between">
        <span><span class="text-secondary-600 font-semibold">+<%= @stats.dig(:renovate, :today) || 0 %></span> <span class="text-gray-500 text-xs">aujourd'hui</span></span>
        <span><span class="font-semibold text-gray-700"><%= @stats.dig(:renovate, :week) || 0 %></span> <span class="text-gray-500 text-xs">cette semaine</span></span>
      </div>
    </div>

    <!-- État système -->
    <div class="bg-white rounded-lg shadow-lg p-6 border-t-4 border-primary-400">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-gray-500 text-xs uppercase tracking-wide">État système</p>
          <p class="text-3xl font-bold mt-2">
            <% if @stats.dig(:security, :status) == 'healthy' %>
              <span class="text-secondary-600">✓ OK</span>
            <% else %>
              <span class="text-red-600">⚠ Alerte</span>
            <% end %>
          </p>
        </div>
        <div class="bg-primary-500 text-white p-3 rounded-lg text-xl">🛡️</div>
      </div>
      <div class="mt-4 pt-4 border-t border-gray-200 text-sm">
        <span class="text-gray-500">DB :</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white <%= @stats.dig(:security, :database, :status) == 'ok' ? 'bg-secondary-600' : 'bg-red-600' %>">
          <%= @stats.dig(:security, :database, :status) || '?' %>
        </span>
        <span class="text-gray-500 ml-2">Env :</span>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-primary-600"><%= @stats.dig(:system, :environment) %></span>
      </div>
    </div>
  </div>

  <!-- Ligne du bas : contacts par type + Ren0vate + activité récente -->
  <div class="grid gap-6 mb-8" style="grid-template-columns: 2fr 1fr 1fr;">

    <!-- Contacts par type -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-5">📊 Contacts par type</h2>
      <% total_contacts = @stats.dig(:contacts, :total).to_f %>
      <% if @stats.dig(:contacts, :by_type).present? %>
        <div class="flex flex-col gap-3.5">
          <% @stats.dig(:contacts, :by_type).each do |type, count| %>
            <div>
              <div class="flex justify-between mb-1.5">
                <span class="text-sm font-medium text-gray-700"><%= type&.gsub('Contact', '') || 'Non spécifié' %></span>
                <span class="text-sm text-gray-500"><%= count %></span>
              </div>
              <div class="bg-gray-200 h-1.5 rounded-full overflow-hidden">
                <% pct = total_contacts > 0 ? (count.to_f / total_contacts * 100) : 0 %>
                <div class="bg-primary-600 h-full rounded-full" style="width: <%= pct %>%;"></div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-400 text-center py-6 text-sm">Aucune donnée</p>
      <% end %>
    </div>

    <!-- Ren0vate détail -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-5">🏠 Ren0vate</h2>
      <% reno = @stats[:renovate] || {} %>
      <div class="flex flex-col gap-3">
        <div class="flex justify-between py-2 border-b border-gray-200">
          <span class="text-xs text-gray-500">Clics (total)</span>
          <span class="font-bold text-secondary-600"><%= reno[:total_clicks] || 0 %></span>
        </div>
        <div class="flex justify-between py-2 border-b border-gray-200">
          <span class="text-xs text-gray-500">Redirects</span>
          <span class="font-bold text-secondary-600"><%= reno[:total_redirects] || 0 %></span>
        </div>
        <div class="flex justify-between py-2 border-b border-gray-200">
          <span class="text-xs text-gray-500">Cette semaine</span>
          <span class="font-bold text-secondary-600"><%= reno[:week] || 0 %></span>
        </div>
        <div class="flex justify-between py-2">
          <span class="text-xs text-gray-500">Aujourd'hui</span>
          <span class="font-bold text-secondary-600"><%= reno[:today] || 0 %></span>
        </div>
        <% if (reno[:by_profile] || {}).any? %>
          <div class="mt-2 pt-3 border-t border-gray-200">
            <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">Par profil (7j)</p>
            <% reno[:by_profile].sort_by { |_, v| -v }.first(3).each do |profile, count| %>
              <div class="flex justify-between mb-1">
                <span class="text-sm text-gray-700 capitalize"><%= profile %></span>
                <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-primary-600"><%= count %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Activité récente -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-5">⏱️ Activité</h2>
      <% [
        { label: 'Aujourd\'hui', contacts: @stats.dig(:contacts, :today) },
        { label: 'Cette semaine', contacts: @stats.dig(:contacts, :week) },
        { label: 'Ce mois', contacts: @stats.dig(:contacts, :month) }
      ].each do |row| %>
        <div class="py-3 border-b border-gray-200">
          <p class="text-gray-500 text-xs uppercase tracking-wide mb-1.5"><%= row[:label] %></p>
          <div class="flex gap-3 flex-wrap text-sm">
            <span><span class="font-bold text-amber-600"><%= row[:contacts] || 0 %></span> <span class="text-gray-400">contacts</span></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Actions rapides -->
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h2 class="text-lg font-bold text-gray-900 mb-4">⚡ Actions rapides</h2>
    <div class="flex gap-3 flex-wrap">
      <%= link_to admin_contacts_path, class: "bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors" do %>
        📧 Contacts (<%= @stats.dig(:contacts, :unread) || 0 %> non lus)
      <% end %>
      <%= link_to admin_security_path, class: "bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors" do %>
        🔒 Sécurité
      <% end %>
      <%= link_to export_admin_contacts_path(format: :csv), class: "bg-gray-600 hover:bg-gray-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors" do %>
        📥 Export CSV
      <% end %>
    </div>
  </div>
</div>
