<% content_for :title, "Ren0vate - Accompagnement complet de votre rénovation" %>
<% content_for :description, "Ren0vate : notre plateforme partenaire pour gérer votre dossier de rénovation de A à Z. Demandez un rendez-vous pour une analyse personnalisée de votre situation." %>
<% content_for :keywords, "renovate belgique, accompagnement rénovation, primes wallonie flandre bruxelles, prêts taux zéro, analyse de situation" %>

<!-- Section Hero -->
<section class="bg-gradient-to-br from-primary-600 via-primary-700 to-secondary-600 text-white py-20 lg:py-28 relative overflow-hidden">
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-0 left-0 w-96 h-96 bg-primary-400 rounded-full filter blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent-400 rounded-full filter blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center">
      <div class="mb-8">
        <h1 class="text-5xl lg:text-7xl font-bold mb-4">
          Ren<span class="text-amber-300">0</span>vate
        </h1>
        <p class="text-xl lg:text-2xl text-white/90">
          Notre plateforme partenaire pour l'accompagnement complet de votre rénovation
        </p>
        <p class="text-lg text-white/80 mt-2">
          Wallonie • Flandre • Bruxelles
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <div class="bg-white/10 backdrop-blur-sm rounded-full px-6 py-2 border border-white/20">
          <span class="text-sm font-semibold">✓ 15 ans d'expertise</span>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-full px-6 py-2 border border-white/20">
          <span class="text-sm font-semibold">✓ +15 000 projets réalisés</span>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-full px-6 py-2 border border-white/20">
          <span class="text-sm font-semibold">✓ +100M€ de primes obtenues</span>
        </div>
      </div>

      <p class="text-white/90 max-w-2xl mx-auto">
        Après une analyse personnalisée de votre situation, nous créons votre dossier dans Ren0vate :
        identification des primes, gestion de chantier, suivi jusqu'à l'obtention. Un accompagnement
        humain, pas un simple outil en libre-service.
      </p>
    </div>
  </div>
</section>

<%= render "pages/renovate_regional_summary" %>

<!-- Ce que fait Ren0vate pour vous -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">
        Ce que Ren0vate gère pour vous
      </h2>
      <p class="text-xl text-gray-600">
        De l'identification des primes à la clôture de chantier
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="bg-gradient-to-br from-pearl to-primary-50 rounded-xl shadow-lg p-6 border-2 border-primary-200">
        <div class="w-14 h-14 bg-primary-600 rounded-full flex items-center justify-center text-3xl mb-4">🎯</div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Identification des primes</h3>
        <p class="text-gray-700 text-sm">Détection de toutes les primes disponibles selon votre profil et votre région.</p>
      </div>

      <div class="bg-gradient-to-br from-pearl to-secondary-50 rounded-xl shadow-lg p-6 border-2 border-secondary-200">
        <div class="w-14 h-14 bg-secondary-600 rounded-full flex items-center justify-center text-3xl mb-4">🏗️</div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Gestion de chantier</h3>
        <p class="text-gray-700 text-sm">Planning, coordination des entrepreneurs, contrôle qualité et réception des travaux.</p>
      </div>

      <div class="bg-gradient-to-br from-pearl to-accent-50 rounded-xl shadow-lg p-6 border-2 border-accent-200">
        <div class="w-14 h-14 bg-accent-600 rounded-full flex items-center justify-center text-3xl mb-4">📸</div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Suivi en temps réel</h3>
        <p class="text-gray-700 text-sm">État d'avancement de votre chantier accessible à tout moment.</p>
      </div>

      <div class="bg-gradient-to-br from-pearl to-amber-50 rounded-xl shadow-lg p-6 border-2 border-amber-200">
        <div class="w-14 h-14 bg-amber-600 rounded-full flex items-center justify-center text-3xl mb-4">📋</div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Dépôt des dossiers</h3>
        <p class="text-gray-700 text-sm">Constitution et dépôt des dossiers de primes jusqu'à l'obtention.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA Final : rendez-vous -->
<section class="py-16 bg-gradient-to-r from-primary-600 via-primary-700 to-secondary-600 text-white">
  <div class="max-w-3xl mx-auto px-4 text-center">
    <h2 class="text-4xl lg:text-5xl font-bold mb-6">
      Parlons de votre projet
    </h2>
    <p class="text-xl text-white/90 mb-8">
      Demandez une analyse de votre situation : nous prenons rendez-vous pour étudier votre dossier
      et vous présenter comment Ren0vate peut vous accompagner.
    </p>

    <%= link_to new_contact_path,
        class: "inline-block bg-amber-400 text-primary-900 px-10 py-4 rounded-xl font-bold text-lg hover:bg-amber-300 transition-all shadow-2xl" do %>
      📋 Demander un rendez-vous
    <% end %>

    <div class="mt-10 pt-8 border-t border-white/20">
      <p class="text-white/90 mb-4">Vous préférez d'abord estimer vos primes ?</p>
      <%= link_to simulation_path,
          class: "inline-block bg-white/10 backdrop-blur-sm text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/20 transition-colors border border-white/20" do %>
        ⬅️ Retour au simulateur de primes
      <% end %>
    </div>
  </div>
</section>
